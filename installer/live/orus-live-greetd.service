[Unit]
Description=Orus OS live session (installer or login screen)
ConditionKernelCommandLine=boot=live
After=systemd-user-sessions.service plymouth-quit-wait.service getty@tty1.service
Conflicts=getty@tty1.service greetd.service

[Service]
Type=simple
ExecStart=/usr/lib/orus/live-greetd
IgnoreSIGPIPE=no
SendSIGHUP=yes
TimeoutStopSec=30s
KeyringMode=shared
Restart=always
RestartSec=1

[Install]
WantedBy=graphical.target

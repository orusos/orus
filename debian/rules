#!/usr/bin/make -f

%:
	dh $@

# The binaries come from cargo, not from a Debian build system.
override_dh_auto_build:
	scripts/build.sh
	scripts/fetch-pdfium.sh
	[ -f out/apps/orus-store/index.html ] || scripts/build-apps.sh orus-store
	[ -f out/apps/system-settings/index.html ] || scripts/build-apps.sh
	[ -f out/apps/react-shadcn-suite/index.html ] || scripts/build-apps.sh react-shadcn-suite

override_dh_auto_install:
	:

# Refuse stale/misnamed browser artifacts even when a builder reuses out/bin.
override_dh_install:
	scripts/check-runtime.sh
	dh_install

override_dh_auto_test:
	python3 -m unittest discover -s scripts -p 'test_runtime*.py'
	cargo test --locked --manifest-path shell/Cargo.toml -p orus --test runtime_launch
	cargo test --locked --manifest-path shell/Cargo.toml -p orus-shell --test web_app

# The installer reads the license from the file, so keep it uncompressed.
override_dh_compress:
	dh_compress -Xusr/share/doc/waid-runtime/LICENSE-waid-runtime-BSL-1.1.txt

override_dh_auto_clean:
	:

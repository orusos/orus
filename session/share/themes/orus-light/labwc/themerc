# Orus OS light window chrome: matches the shell's own windows
# (orus-shell/src/app_window.rs) and the light colors in orus-shell/src/palette.rs.
border.width: 1
window.active.border.color: #e1e3e7
window.inactive.border.color: #e1e3e7

window.titlebar.padding.width: 3
window.titlebar.padding.height: 0
window.button.width: 50
window.button.height: 48
window.button.spacing: 0
window.button.hover.bg.corner-radius: 8

window.active.title.bg.color: #f1f3f6
window.inactive.title.bg.color: #f6f7f9
window.active.label.text.color: #1c2227
window.inactive.label.text.color: #5d6870
window.label.text.justify: Left

window.active.shadow.size: 32
window.active.shadow.color: #00000033
window.inactive.shadow.size: 16
window.inactive.shadow.color: #0000001a

# Alt+Tab thumbnails: the dock's colors, the selected window on the selection color
# with an accent outline.
osd.bg.color: #e9eef0
osd.border.color: #c3d0d4
osd.border.width: 1
osd.label.text.color: #1c2227
osd.window-switcher.style-thumbnail.padding: 10
osd.window-switcher.style-thumbnail.item.width: 240
osd.window-switcher.style-thumbnail.item.height: 190
osd.window-switcher.style-thumbnail.item.padding: 8
osd.window-switcher.style-thumbnail.item.active.bg.color: #d9e9eb
osd.window-switcher.style-thumbnail.item.active.border.color: #1f8285
osd.window-switcher.style-thumbnail.item.active.border.width: 2
osd.window-switcher.preview.border.width: 2
osd.window-switcher.preview.border.color: #1f8285
